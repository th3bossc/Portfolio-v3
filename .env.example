# Copy to .env.local. Never commit credentials.
MONGODB_URI=
MONGODB_DB=portfolio
# Explicit OAuth origin (also required when running npm start locally).
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Immutable numeric GitHub account ID, not your username.
ADMIN_GITHUB_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
